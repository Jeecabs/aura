{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Private pi package that adds an audio-reactive glow to Pi's input frame.",
  "keywords": [
    "pi-package",
    "audio",
    "macos"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "verify": "pnpm run check && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.0 <0.85.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
